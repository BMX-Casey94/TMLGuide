{
  "name": "tmlguide-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "build:release": "next build && node scripts/generate-csp-hashes.mjs && next build && node scripts/generate-csp-hashes.mjs --check",
    "csp:hashes": "node scripts/generate-csp-hashes.mjs",
    "csp:check": "node scripts/generate-csp-hashes.mjs --check",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
