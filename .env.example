# Copy to .env.local and fill in. Never commit real values.

# Canonical origin, used for metadata, sitemap and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (added in the community and admin workstream)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. The contact route writes to PostgREST, so it needs the project URL
# as well as the service role key. Both must be https: in production.
SUPABASE_URL=

# Security
# Salt applied before a client IP is hashed for rate-limit keys. Use a long
# random value; without it the digests are unsalted, so a stored key could be
# matched against a list of guessed addresses. 32+ characters.
RATE_LIMIT_IP_SALT=
# Number of reverse proxies you trust in front of this app. It decides which
# x-forwarded-for entry is treated as the client. Leave at 1 unless you know the
# chain; a larger value must match the real topology or the limit can be evaded.
TRUSTED_PROXY_COUNT=
# Optional CSP violation endpoint. Sent with report-uri and Report-To.
CSP_REPORT_URI=

# Shared rate limiting (Upstash Redis REST). Both must be set in production;
# without them the limiter falls back to per-instance memory and logs a warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Consent-gated analytics. Nothing is sent unless a visitor opts in AND this is
# set. Must be https: outside localhost.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Contact form delivery (server only)
WEB3FORMS_ACCESS_KEY=

# Bot challenge (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI guide (server only; provider chosen after the provider spike)
AI_PROVIDER=
AI_API_KEY=
AI_MONTHLY_SPEND_CAP_GBP=
